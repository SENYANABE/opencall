digraph G {
  graph [rankdir=TB, bgcolor="#EEF3FF", pad="0.6", nodesep="0.5", ranksep="0.45", fontname="Inter",
         label=<<FONT POINT-SIZE="30" COLOR="#1F4BFF"><B>ОПЕНКОЛЛ · пайплайн и точки контроля качества</B></FONT><BR/><FONT POINT-SIZE="15" COLOR="#4A5A85">github.com/SENYANABE/opencall · белый блок: код · голубой: LLM · синий: редактор · жёлтая плашка: контроль</FONT>>,
         labelloc=t];
  node [fontname="Inter"]; edge [color="#1F4BFF", penwidth=2, arrowsize=0.9, fontname="Inter"];
  trig [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#4A5A85"><B>КОД</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="19" COLOR="#0A1A44"><B>Триггеры</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#4A5A85">Расписание GitHub Actions: 07:00 и 15:00 МСК</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#4A5A85">Пятница 10:00: дедлайны недели · 1-е число: опрос</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#4A5A85">Проверка кнопок бота: каждые 10 минут</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#1F4BFF", penwidth=2, margin="0.25,0.18"];
src [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#4A5A85"><B>КОД</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="19" COLOR="#0A1A44"><B>1. Сбор</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#4A5A85">Белый список sources.csv: сайты организаторов (A),</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#4A5A85">агрегаторы (B), СМИ и ТГ-каналы (C)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF3DC" CELLPADDING="6"><FONT POINT-SIZE="13" COLOR="#A86400"><B>Контроль: </B>новые источники добавляет только редактор</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#1F4BFF", penwidth=2, margin="0.25,0.18"];
ext [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#4A5A85"><B>LLM</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="19" COLOR="#0A1A44"><B>2. Извлечение</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#4A5A85">Текст страницы → анонсы по JSON-схеме:</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#4A5A85">название, ссылка, дедлайн, взнос, приз, доступ из РФ</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF3DC" CELLPADDING="6"><FONT POINT-SIZE="13" COLOR="#A86400"><B>Контроль: </B>факты только из текста, нет данных = пустое поле</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#F1F4FF", color="#1F4BFF", penwidth=2, margin="0.25,0.18"];
sel [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#4A5A85"><B>КОД</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="19" COLOR="#0A1A44"><B>3. Отбор</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#4A5A85">Дубли по ссылке и названию, сортировка по дедлайну,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#4A5A85">лимит 10 карточек за запуск</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF3DC" CELLPADDING="6"><FONT POINT-SIZE="13" COLOR="#A86400"><B>Контроль: </B>нет ссылки · нет или прошёл дедлайн · &lt; 3 дней · не про дизайн · недоступно из РФ</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#1F4BFF", penwidth=2, margin="0.25,0.18"];
ver [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#4A5A85"><B>LLM</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="19" COLOR="#0A1A44"><B>4. Сверка с организатором</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#4A5A85">Открываем страницу организатора, сравниваем</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#4A5A85">дедлайн, взнос, приз, доступ из РФ</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF3DC" CELLPADDING="6"><FONT POINT-SIZE="13" COLOR="#A86400"><B>Контроль: </B>расхождение → флаг редактору, верим организатору</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#F1F4FF", color="#1F4BFF", penwidth=2, margin="0.25,0.18"];
card [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#4A5A85"><B>LLM</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="19" COLOR="#0A1A44"><B>5. Карточка и обложка</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#4A5A85">LLM пишет текст по ToV, код собирает пост по шаблону.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#4A5A85">Обложка 4:5 по референсам стиля ДЗ2</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF3DC" CELLPADDING="6"><FONT POINT-SIZE="13" COLOR="#A86400"><B>Контроль: </B>стоп-лист, без «!» и эмодзи, ≤ 600 знаков, флаг платного взноса</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#F1F4FF", color="#1F4BFF", penwidth=2, margin="0.25,0.18"];
mod [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#DCE4FF"><B>РЕДАКТОР</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="19" COLOR="#FFFFFF"><B>6. Модерация</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#DCE4FF">Черновик с обложкой и флагами приходит в бот:</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#DCE4FF">Опубликовать · Без обложки · 5 причин отказа</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF3DC" CELLPADDING="6"><FONT POINT-SIZE="13" COLOR="#A86400"><B>Контроль: </B>без нажатия редактора пост не выходит</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#1F4BFF", color="#1F4BFF", penwidth=2, margin="0.25,0.18"];
pub [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#4A5A85"><B>КОД</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="19" COLOR="#0A1A44"><B>7. Публикация</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#4A5A85">Пост в канал, ссылка и статус в лог</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF3DC" CELLPADDING="6"><FONT POINT-SIZE="13" COLOR="#A86400"><B>Контроль: </B>ошибка Телеграма → статус и кнопка «Повторить»</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#1F4BFF", penwidth=2, margin="0.25,0.18"];
an [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#4A5A85"><B>КОД</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="19" COLOR="#0A1A44"><B>8. Статистика</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#4A5A85">STATS.md после каждого запуска: собрано, брак с причинами,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#4A5A85">опубликовано · подписчики, просмотры, ERR</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#1F4BFF", penwidth=2, margin="0.25,0.18"];
sug [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#4A5A85"><B>КОД</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="19" COLOR="#0A1A44"><B>Предложения подписчиков</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#4A5A85">Ссылка боту → лог (без ников) → пересылка редактору</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF3DC" CELLPADDING="6"><FONT POINT-SIZE="13" COLOR="#A86400"><B>Контроль: </B>источник попадает в белый список только после проверки</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#1F4BFF", penwidth=2, margin="0.25,0.18"];
rej1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#C8322A"><B>отбраковано_авто</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#C8322A">причина в data/log.csv</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#FDECEB", color="#C8322A", margin="0.2,0.12"];
rej2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#C8322A"><B>отбраковано_авто</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#C8322A">стоп-лист, дедлайн по организатору</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#FDECEB", color="#C8322A", margin="0.2,0.12"];
rej3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#C8322A"><B>отклонено</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#C8322A">причина из кнопки редактора</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#FDECEB", color="#C8322A", margin="0.2,0.12"];
ok [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#0E8A4F"><B>опубликовано</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#0E8A4F">ссылка на пост в логе</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#E3F6EC", color="#0E8A4F", margin="0.2,0.12"];
  trig -> src
src -> ext
ext -> sel
sel -> ver [label=<<FONT POINT-SIZE="12" COLOR="#4A5A85">прошло</FONT>>]
sel -> rej1 [style=dashed, color="#C8322A"]
ver -> card
card -> rej2 [style=dashed, color="#C8322A"]
card -> mod
mod -> pub
mod -> rej3 [style=dashed, color="#C8322A"]
pub -> ok
ok -> an
sug -> mod [style=dotted]
  {rank=same; sel; rej1} {rank=same; card; rej2} {rank=same; mod; rej3; sug}
}